{
  "framework": "vite",
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "rewrites": [
    {
      "source": "/api/bible/:book/:chapter/:verse",
      "destination": "/api/bible?book=:book&chapter=:chapter&verse=:verse"
    },
    {
      "source": "/api/health",
      "destination": "/api/health"
    },
    {
      "source": "/api/state/(.*)",
      "destination": "/api/state?account=$1"
    },
    {
      "source": "/api/state",
      "destination": "/api/state"
    },
    {
      "source": "/api/auth/(.*)",
      "destination": "/api/auth?action=$1"
    },
    {
      "source": "/api/auth",
      "destination": "/api/auth"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}
